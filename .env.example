# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/arenahub_dev
DATABASE_USERNAME=arenahub
DATABASE_PASSWORD=arenahub

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64

# ─── Google OAuth2 ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=arenahub
R2_PUBLIC_URL=https://pub.your-domain.com

# ─── AI Validation ───────────────────────────────────────────────────────────
AI_VALIDATION_URL=https://your-ai-service.com/validate
AI_VALIDATION_API_KEY=your-ai-api-key
